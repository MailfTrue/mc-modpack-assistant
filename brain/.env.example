# Скопируй в brain/.env и заполни.

# --- Telegram ---
# Токен от @BotFather. Боту нужно выключить privacy mode: /setprivacy → Disable.
TELEGRAM_BOT_TOKEN=
# Чаты, где бот работает (через запятую). Узнать id: написать /chatid в чате с ботом.
ALLOWED_CHAT_IDS=
# Куда слать события сервера. По умолчанию — первый из ALLOWED_CHAT_IDS.
# EVENTS_CHAT_ID=

# --- Сервер Minecraft ---
SERVER_DIR=C:/Users/1/Documents/minecraft-servers/prominence-2

# --- LLM (Claude Code, подписка) ---
# Авторизация берётся из `claude login` на этом ПК.
# Либо долгоживущий токен: `claude setup-token`, затем:
# CLAUDE_CODE_OAUTH_TOKEN=
# Модель: sonnet | opus | haiku или полный id
LLM_MODEL=sonnet
LLM_MAX_TURNS=30
LLM_TIMEOUT_SECONDS=240
QUESTIONS_PER_USER_PER_DAY=50

# --- Мост с модом ---
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
# Если пусто — берётся из SERVER_DIR/config/modpack-bridge.json (мод создаёт его сам).
# BRIDGE_TOKEN=
